# 設定するとこの値が設定画面より優先される。設定画面だけで使うなら空のままにする。
# Anthropic の API キー (例: sk-ant-...)
ANTHROPIC_API_KEY=
# 設定するとこの値が設定画面より優先される。設定画面だけで使うなら空のままにする。
# OpenAI 互換 API のベース URL (例: http://127.0.0.1:8888/v1)
LLM_BASE_URL=
# 設定するとこの値が設定画面より優先される。設定画面だけで使うなら空のままにする。
# OpenAI 互換 API のキー (例: local。ローカル LLM なら任意の文字列)
LLM_API_KEY=
# 設定するとこの値が設定画面より優先される。設定画面だけで使うなら空のままにする。
# OpenAI 互換 API のモデル名 (例: qwen3.8-27b-exl3-2.0bpw)
LLM_MODEL=
# 設定するとこの値が設定画面より優先される。設定画面だけで使うなら空のままにする。
# Markdown ログの置き場所 (例: C:\path\to\AI)
LOG_ROOT=
