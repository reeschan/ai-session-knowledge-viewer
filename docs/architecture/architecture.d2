# knowledge-app のアーキテクチャ図
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py docs/architecture/architecture.d2
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  saas: {
    style: {
      border-radius: 16
      stroke-dash: 3
    }
  }
}

user: "利用者\nブラウザで画面を見る" {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

local: "ローカル PC（127.0.0.1）" {
  class: zone
  icon: https://icons.terrastruct.com/tech%2Flaptop.svg

  app: "Next.js アプリ\n画面（一覧・詳細・学び・マニュアル・設定・スキル生成）\nAPI（設定保存・スキルのインストール）" {
    class: svc
    icon: https://cdn.simpleicons.org/nextdotjs/__MONO__
  }

  cli: "CLI（pnpm）" {
    class: zone
    icon: https://cdn.simpleicons.org/pnpm

    analyze: "analyze\n未解析のログを LLM で解析" {
      class: svc
    }
    digest: "digest\n日次・週次ダイジェスト" {
      class: svc
    }
    configure: "configure\n自動セットアップ" {
      class: svc
    }
  }

  data: "data/\nsettings.json・analysis.json\nlog-index.json" {
    shape: cylinder
  }

  logs: "ログフォルダ（読み取り専用）\nClaude Code ~/.claude/projects\nCodex ~/.codex/sessions\nMarkdown ログ" {
    class: svc
    shape: page
  }

  cc: "Claude Code\n保管スキル + Stop フック" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }

  desktop: "Claude Desktop\n定期実行タスク" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
}

external: 外部サービス {
  class: saas
  direction: down

  anthropic: "Anthropic API" {
    class: ext
    icon: https://cdn.simpleicons.org/anthropic/__MONO__
  }
  openai: "OpenAI 互換 API\nローカル LLM も可" {
    class: ext
    shape: hexagon
    width: 64
    height: 64
  }
  slack: "Slack" {
    class: ext
    icon: https://icons.terrastruct.com/dev%2Fslack.svg
  }
}

user -> local.app: 画面を開く
local.logs -> local.app: 読み取り
local.logs -> local.cli.analyze: 読み取り
local.app <-> local.data
local.cli.analyze <-> local.data
local.cli.analyze -> external.anthropic: 解析
local.cli.analyze -> external.openai: 解析
local.cc -> local.logs: 保管 {style.stroke-dash: 4}
local.desktop -> local.cli.digest: npm run digest {style.stroke-dash: 4}
local.cli.digest -> external.slack: 投稿 {style.stroke-dash: 4}
