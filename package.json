{
  "name": "knowledge-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently -k -n css,server \"tailwindcss -i server/styles.css -o public/app.css --watch\" \"tsx watch server/index.ts\"",
    "build:css": "tailwindcss -i server/styles.css -o public/app.css --minify",
    "build": "pnpm build:css && tsc --noEmit",
    "start": "pnpm build && tsx server/index.ts",
    "lint": "eslint",
    "analyze": "tsx scripts/analyze.ts",
    "digest": "tsx scripts/digest.ts",
    "configure": "tsx scripts/setup.ts",
    "test": "pnpm build:css && node --import tsx --test --test-reporter=tap \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "marked": "^18.1.0",
    "openai": "^7.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^26.6.5",
    "concurrently": "10.0.6",
    "eslint": "^10.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
